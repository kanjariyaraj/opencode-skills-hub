{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kanjariyaraj/opencode-skills-hub/schemas/resource.schema.json",
  "title": "OpenCode Skills Hub Resource",
  "description": "A single verified or discovered resource entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "description",
    "primary_category",
    "tags",
    "source",
    "install",
    "compatibility",
    "license",
    "security",
    "verification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Stable, unique, kebab-case identifier."
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "type": {
      "type": "string",
      "enum": ["skill", "agent", "plugin", "mcp", "theme", "command", "rule", "hook", "provider"]
    },
    "description": { "type": "string", "minLength": 20, "maxLength": 600 },
    "primary_category": {
      "type": "string",
      "enum": [
        "software-development",
        "mobile-development",
        "android-system-custom-rom",
        "linux-low-level",
        "database-backend",
        "devops-cloud",
        "cybersecurity",
        "ai-machine-learning",
        "data-science",
        "game-development",
        "design-ui-ux",
        "image-generation",
        "video-generation",
        "audio-music",
        "content-marketing",
        "documents-productivity",
        "education-research",
        "business-finance"
      ]
    },
    "secondary_categories": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+.#-]*$" },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "kind"],
      "properties": {
        "url": { "type": "string", "minLength": 3 },
        "kind": {
          "type": "string",
          "enum": ["github", "npm", "pypi", "docs", "website", "unknown"]
        },
        "documentation": { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "requires_api_key", "tested"],
      "properties": {
        "instructions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requires_api_key": { "type": "boolean" },
        "tested": {
          "type": "string",
          "enum": ["INSTALLATION_TESTED", "NOT_TESTED", "NOT_APPLICABLE", "BLOCKED"]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opencode", "platforms", "dependencies"],
      "properties": {
        "opencode": {
          "type": "string",
          "enum": ["native", "compatible", "unknown", "incompatible"]
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "status"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["LICENSE_VERIFIED", "LICENSE_REVIEW_REQUIRED", "NOASSERTION", "UNKNOWN"]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "notes"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["LOW RISK", "REVIEWED", "REVIEW REQUIRED", "HIGH RISK", "UNSAFE", "DEPRECATED"]
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "date", "notes"],
      "properties": {
        "status": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "DISCOVERED",
              "SOURCE_VERIFIED",
              "LICENSE_VERIFIED",
              "COMPATIBILITY_VERIFIED",
              "INSTALLATION_TESTED",
              "FUNCTIONAL_TESTED",
              "MAINTAINED",
              "UNAVAILABLE",
              "DUPLICATE",
              "UNMAINTAINED",
              "INCOMPATIBLE",
              "LICENSE_REVIEW_REQUIRED",
              "SECURITY_REVIEW_REQUIRED"
            ]
          }
        },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_stars_observed": { "type": ["integer", "null"], "minimum": 0 },
        "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "latest_release": { "type": ["string", "null"] },
        "last_push": { "type": ["string", "null"] }
      }
    },
    "requires_alias_of": { "type": ["string", "null"] }
  }
}
